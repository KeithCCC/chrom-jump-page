{
  "manifest_version": 3,
  "name": "TabNest - お気に入りダッシュボード",
  "short_name": "TabNest",
  "version": "1.1.2",
  "description": "Chromeの新しいタブで、ブックマークを見やすく・探しやすく・ワンクリックで開けるダッシュボード。",
  "permissions": ["bookmarks", "storage", "favicon"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
